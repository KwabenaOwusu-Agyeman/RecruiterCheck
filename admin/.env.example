# Control Centre (admin/) environment variables. NAMES ONLY, never values.
#
# This is a second Vercel project, myrecruitercheck-admin, separate from the
# SPA and separate from Supabase Edge Function secrets. Setting a variable in
# one of those does not set it here, which is how STRIPE_SECRET_KEY came to be
# live for the Edge Functions and unset for this app at the same time.
#
# Set real values in Vercel: the myrecruitercheck-admin project, Settings,
# Environment Variables. Vercel applies them at build time, so an existing
# deployment does not pick up a new variable until you redeploy.
#
# Locally these go in admin/.env.local, which .gitignore excludes.

# Supabase, the project this dashboard reads. Public, and also used by the
# browser client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PRIVILEGED. Bypasses RLS entirely and reads production candidate and payment
# data. server/env.ts imports 'server-only' so importing it from a client
# component is a build error rather than a runtime leak. Never prefix this
# NEXT_PUBLIC_, which would bundle it into the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PRIVILEGED but OPTIONAL. Absent means the Payments and Refunds screens show
# the application's own record with an explicit "Not reconciled against Stripe"
# notice, rather than silently implying the two agree.
#
# Use a RESTRICTED key (rk_live_...), not the secret key (sk_live_...). This app
# only ever reads, so it needs exactly three permissions set to Read and every
# other one left at None:
#
#   PaymentIntents   server/stripe.ts reconcilePayment
#   Charges          the expand: ['latest_charge'] on that same retrieve
#   Refunds          server/stripe.ts reconcileRefund
#
# Charges is the one that is easy to miss: without it the expand fails while
# everything else appears to work. A full secret key here would give a dashboard
# that already holds the service role the ability to create charges and issue
# refunds, which it has no reason to do.
#
# For Preview, either leave this unset or use a test mode restricted key. A
# preview deployment reconciling against live Stripe data is not something you
# want by accident.
# STRIPE_SECRET_KEY=

# Where the "Back to MyRecruiterCheck" link points. Defaults to
# https://myrecruitercheck.com when unset.
# NEXT_PUBLIC_SITE_URL=https://myrecruitercheck.com
