# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# UI-only test-account exclusion (e.g. hiding the Trustpilot prompt on the
# results page for internal test accounts). Not a security boundary — this
# is bundled into the public app. Comma-separated emails.
# VITE_TEST_ACCOUNT_EMAILS=

# Edge function secrets (set in Supabase dashboard, not in frontend)
# GEMINI_API_KEY=
# STRIPE_SECRET_KEY=
# SITE_URL=https://your-domain.com

# Shared secret pg_cron would present (x-cron-secret header) when invoking
# reconcile-ambiguous-refunds. Not set in production as of 2026-09-03: the
# function fails closed with 503 until it is, and the cron job that would call
# it has not been applied. See that function's index.ts header.
# CRON_INVOKE_SECRET=

# Declares which Stripe mode a deployment talks to. Must be exactly "test" or
# "production" — there is no default, and every Stripe edge function refuses to
# run if it is unset, misspelled, or disagrees with the STRIPE_SECRET_KEY
# prefix (sk_test_ vs sk_live_). Production is live, so production must be set
# to "production". Set this BEFORE deploying the guard, or billing, refunds and
# account deletion will fail closed. See supabase/functions/_shared/stripe-environment.ts
# STRIPE_ENVIRONMENT=production

# "Your Recruiter Check is ready" email + Trustpilot AFS integration
# (analyze-check edge function) — all set as Supabase edge function secrets,
# never in this file with real values or pasted into chat.
# BREVO_API_KEY=                        # Brevo transactional email API key
# BREVO_SENDER_EMAIL=notifications@myrecruitercheck.com
# BREVO_SENDER_NAME=MyRecruiterCheck
# TRUSTPILOT_AFS_EMAIL=                 # Trustpilot's invite.trustpilot.com BCC address; omitted entirely if unset
# TEST_ACCOUNT_EMAILS=                  # Comma-separated emails to exclude from this email (see scripts/reset-test-users.ts)
# TRUSTPILOT_EMAIL_TEST_MODE=true       # true = runs all gating/claim logic but never calls Brevo; set to "false"/unset to send for real

# Welcome email (send-welcome-email edge function, invoked directly by the
# authenticated client app — see src/services/welcomeEmailService.ts).
# Reuses BREVO_API_KEY / BREVO_SENDER_EMAIL / BREVO_SENDER_NAME above. Set
# as a Supabase edge function secret, never in this file with a real value.
# Not sensitive on its own, but must be set precisely (see BREVO_SETUP.md)
# since the function fails closed (sends nothing) if it's missing or
# unparseable, and existing verified users would wrongly become eligible
# if it were set to a date before they signed up.
# WELCOME_EMAIL_ROLLOUT_AT=2026-08-27T00:00:00Z   # ISO 8601 — only accounts created on/after this instant get a welcome email

# send-password-changed-email edge function is deployed but currently
# unused — the "password changed" notice is sent by Supabase's own built-in
# Auth security notification instead (see BREVO_SETUP.md). No secret
# needed for it while nothing calls it.

# Instagram (Meta) integration — all set as Supabase edge function secrets,
# never in this file with real values. See docs/INSTAGRAM_MCP_SETUP.md.
# INSTAGRAM_APP_ID=                     # Meta App ID (not secret, but still kept out of the frontend bundle)
# INSTAGRAM_APP_SECRET=                 # Meta App Secret — from Meta for Developers only, never paste into chat
# INSTAGRAM_OAUTH_REDIRECT_URI=         # e.g. https://<project-ref>.supabase.co/functions/v1/instagram-oauth-callback
# INSTAGRAM_ADMIN_TOKEN=                # Long random secret you generate; gates instagram-oauth-start
# INSTAGRAM_STATE_SECRET=               # Long random secret; signs the OAuth state parameter
# GRAPH_API_VERSION=                    # e.g. v23.0 — confirm current version at developers.facebook.com/docs/graph-api/changelog
# MCP_SERVER_TOKEN=                     # Long random secret; bearer token Claude sends to instagram-mcp
# INSTAGRAM_TEST_MODE=true              # true = validates everything but never actually publishes; set to "false" to allow real publishing
